    "@scure/bip39": "^1.6.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "rxjs": "^7.8.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
