{
  "name": "proof-of-healing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "contract:compile": "compact compile contracts/src/ProofOfHealingNative.compact contracts/build && node -e \"require('fs').writeFileSync('contracts/build/package.json', '{\\\"type\\\":\\\"module\\\"}\\n')\"",
